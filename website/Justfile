#!/usr/bin/env just --justfile

set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]
set shell := ["bash", "-c"]

default:
    @just --list

# Install Composer (PHP) and pnpm (JavaScript) dependencies
install:
    composer install
    pnpm install

# Install, then start the Vite dev server and the PHP API together
dev: install
    pnpm run dev

# Build the site into dist/, with the API and its vendor/ folder beside it
[windows]
build: clean install
    pnpm run build
    @Copy-Item ./api, ./vendor ./dist/ -Recurse -Force
    @Remove-Item ./dist/api/.env, ./dist/api/var -Recurse -Force -ErrorAction SilentlyContinue

[linux]
[macos]
build: clean install
    pnpm run build
    @cp -r ./api ./vendor ./dist/
    @rm -rf ./dist/api/.env ./dist/api/var

[windows]
clean:
    @if (Test-Path .\dist\) { Remove-Item .\dist\ -Force -Recurse }

[linux]
[macos]
clean:
    @rm -rf ./dist

# Write the local .env for the API from the dev defaults
env:
    php scripts/dev-env.php

# Start the local MySQL container and wait until it is healthy
db-up:
    docker compose -f ../.docker/mysql.compose.yaml up -d --wait

# Stop the local MySQL container, keeping its data
db-down:
    docker compose -f ../.docker/mysql.compose.yaml down

# Wipe the local MySQL data and start a fresh container
db-reset:
    docker compose -f ../.docker/mysql.compose.yaml down -v
    docker compose -f ../.docker/mysql.compose.yaml up -d --wait

# Apply the database migrations
migrate:
    php scripts/migrate.php

# Load the development seed data
seed:
    php scripts/seed.php

# Run the PHPUnit test suite
test:
    php vendor/bin/phpunit
